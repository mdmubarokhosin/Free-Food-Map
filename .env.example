# Firebase Configuration
# Get these from your Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Admin Secret (for admin panel access)
# Generate a secure random string
ADMIN_SECRET=your_admin_secret_here

# Bohudur Payment Gateway
# Get your API key from https://console.bohudur.one/
# Documentation: https://docs.bohudur.one/
BOHUDUR_API_KEY=your_bohudur_api_key_here

# Base URL (optional - auto-detected in most cases)
# Required for webhook callbacks on local development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
